
# LanCache-NG (https://github.com/wiki-mod/lancache-ng)
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# What: tracked template; copy to .env.local and edit there.
# Why: setup.sh prefers .env.local; git pulls stay clean.
# From: Issue #1683

# What: two LAN IPs; dns-http and dns-https bind one each.
# Why: one IP per answer path keeps the caches apart.
# From: Issue #1683
IP_STANDARD=192.168.234.10
IP_SSL=192.168.234.11

# What: TSIG key for Kea DDNS updates; setup.sh fills it.
# Why: it allows writes to the LAN zone; keep it secret.
DDNS_TSIG_KEY=

# What: static NATS roles; setup.sh fills the passwords.
# Why: secondaries get their own login by auth callout.
# From: Issue #583
NATS_UI_USER=lancache-ui
NATS_UI_PASSWORD=
NATS_DNS_WRITER_USER=lancache-dns-writer
NATS_DNS_WRITER_PASSWORD=
NATS_DNS_REPLICA_USER=lancache-dns-replica
NATS_DNS_REPLICA_PASSWORD=
NATS_CALLOUT_USER=lancache-nats-callout
NATS_CALLOUT_PASSWORD=
NATS_SYS_USER=lancache-nats-sys
NATS_SYS_PASSWORD=

# What: secondary registration token; openssl rand -hex 32.
# Why: the ui refuses an empty or placeholder value.
# From: Issue #659
SECONDARY_REGISTRATION_TOKEN=CHANGE_ME_SECONDARY_REGISTRATION_TOKEN

# What: PowerDNS API key for dns and ui; empty = generated.
# Why: it controls the PowerDNS HTTP API; keep it secret.
PDNS_API_KEY=

# What: Netdata alarm webhook token; empty = generated.
# Why: only Netdata may post alarms to the ui dashboard.
# From: Issue #849
NETDATA_ALARM_TOKEN=

# What: Kea control token for dhcp and ui.
# Why: only the ui may change the running Kea config.
KEA_CTRL_TOKEN=CHANGE_ME_KEA_CTRL_TOKEN
# What: Kea control agent user and its host port.
# Why: dhcp serves it; ui and setup.sh log in with it.
# From: Issue #1683
KEA_CTRL_USER=admin
KEA_CTRL_PORT=8000
# What: Kea snapshot dir inside the dhcp and ui containers
# Why: UI writes, dhcp rescue mode reads; one shared path
# From: Issue #1683 | PR #1858
KEA_CONFIG_SNAPSHOT_DIR=/var/lib/kea/config-snapshots

# What: ui Basic Auth; both empty needs ALLOW_INSECURE_UI.
# Why: an open ui must be an explicit operator choice.
UI_AUTH_USER=
UI_AUTH_PASSWORD=
ALLOW_INSECURE_UI=false

# What: image source; TAG is latest, nightly or vX.Y.Z
# Why: latest is built from master, nightly from current_dev
# From: Issue #1683 | PR #1858
LANCACHE_IMAGE_REGISTRY=ghcr.io
LANCACHE_IMAGE_PREFIX=wiki-mod/lancache-ng
LANCACHE_IMAGE_TAG=latest

# What: root of every bind-mounted state directory.
# Why: unset compose *_DIR overrides derive from it.
# From: Issue #445
LANCACHE_STATE_DIR=/opt/lancache-ng

# What: known-good configs kept per service for rollback.
# Why: proxy, dns, dhcp and ui read this one value.
# From: Issue #415
KEEP_KNOWN_GOOD_CONFIGS=3

# What: proxy cache size, RAM keys zone and validity
# Why: compose maps these into proxy; one owner here
# From: Issue #1683 | PR #1858
CACHE_MAX_SIZE=50g
CACHE_MEM_MB=512
CACHE_SLICE_SIZE=8m
CACHE_VALID_HIT=365d
CACHE_VALID_ANY=1m
CACHE_INACTIVE=365d
# What: free-space floor; nginx evicts below it.
# Why: CACHE_MAX_SIZE is no hard limit on a shared disk.
# From: Issue #849
CACHE_MIN_FREE=1g
# What: real upstream DNS for nginx; IPv6 bracketed
# Why: the LanCache DNS would loop back (AG-OP-002)
NGINX_UPSTREAM_RESOLVER=8.8.8.8 8.8.4.4 [2001:4860:4860::8888] [2001:4860:4860::8844]
# What: lazy proxies any host; strict only cdn-domains
# Why: lazy keeps new CDN names working (AG-OP-003)
PROXY_SECURITY_MODE=lazy
# What: optional client CIDR allowlist; empty allows all
# Why: clients are otherwise limited by the bound ports
PROXY_ALLOWED_CLIENT_CIDRS=

# What: Kea pool for the dhcp container in kea mode.
# Why: compose maps these into dhcp; one owner here.
# From: Issue #1683
DHCP_SUBNET=10.0.0.0/24
DHCP_RANGE_START=10.0.0.128
DHCP_RANGE_END=10.0.0.254
DHCP_GATEWAY=10.0.0.1
# What: Kea domain, lease seconds, DDNS on/off.
# Why: DDNS writes A and PTR per lease; opt-in.
# From: Issue #1076
DHCP_DOMAIN=lan
DHCP_LEASE_TIME=86400
DHCP_DDNS_ENABLED=false
# What: NTP servers handed out by DHCP; empty = none.
# Why: clients get a working clock without the LAN NTP.
# From: Issue #1683
DHCP_NTP_SERVERS=debian.pool.ntp.org,time.nist.gov

# What: dnsmasq proxy and relay values; the ui may override.
# Why: compose maps these into dhcp; one owner here.
# From: Issue #1683
DHCP_SUBNET_START=
DHCP_DNS_PRIMARY=
DHCP_DNS_SECONDARY=
UPSTREAM_DHCP_IP=
# What: relay mode only: this relay's client-side IP
# Why: dnsmasq stamps it as giaddr for the upstream pool
# From: Issue #844
DHCP_RELAY_LOCAL_ADDR=
# What: optional PXE-scoped options; empty = not sent
# Why: ProxyDHCP works with the four values above alone
# From: Issue #450
DHCP_PROXY_INTERFACE=
DHCP_PROXY_ROUTER=
DHCP_PROXY_DOMAIN=
DHCP_PROXY_BOOT_FILENAME=
DHCP_PROXY_BOOT_SERVER=
DHCP_PROXY_CUSTOM_OPTIONS=
# What: PXE boot pointer; needs server plus a filename
# Why: dnsmasq starts replying to PXE clients once set
# From: Issue #705
DHCP_PROXY_PXE_BOOT_SERVER=
DHCP_PROXY_PXE_BOOT_FILENAME_BIOS=
DHCP_PROXY_PXE_BOOT_FILENAME_UEFI=

# What: loopback UDP port of syslog-ng in services.
# Why: Docker sends every container's log lines there.
# From: Issue #1683
LANCACHE_LOG_PORT=5514

# What: log budget; retry pause after a failed prune.
# Why: size wins over age; the watchdog prunes both.
# From: Issue #1683
SYSLOG_MAX_GB=10
SYSLOG_RETENTION_DAYS=30
SYSLOG_PRUNE_RETRY_COOLDOWN=3600

# What: query logging off; local root zone copy on.
# Why: query logs grow fast; the root copy saves lookups.
# From: Issue #1683
LOG_QUERIES=0
ROOT_ZONE_MIRROR=1
# What: SOA refresh, retry and serial re-anchor seconds.
# Why: secondaries re-poll when a NOTIFY was missed.
# From: Issue #1095
PDNS_SOA_REFRESH=30
PDNS_SOA_RETRY=10
PDNS_SOA_RESYNC_INTERVAL=3600

# What: NTP upstreams (host = pool, IP = server).
# Why: the ui may override both; empty CIDRs allow all.
# From: Issue #1683
NTP_UPSTREAM_SERVERS=0.debian.pool.ntp.org 1.debian.pool.ntp.org 2.debian.pool.ntp.org 3.debian.pool.ntp.org time.cloudflare.com
NTP_ALLOWED_CLIENT_CIDRS=

# What: watchdog poll seconds and failures to restart.
# Why: an unhealthy container restarts after 3 checks.
# From: Issue #1683
CHECK_INTERVAL=30
RESTART_AFTER=3
# What: disk use warn and alarm thresholds in percent.
# Why: the ui shows yellow, then red, before it fills.
# From: Issue #1683
DISK_WARN_PCT=85
DISK_ALARM_PCT=95
# What: Docker API timeouts in seconds; 0 = no limit.
# Why: a restart waits longer than a health probe.
# From: Issue #1683
DOCKER_API_TIMEOUT=5
DOCKER_RESTART_TIMEOUT=30
# What: cache files older than this many days go.
# Why: the daily purge frees space nginx kept.
# From: Issue #1683
CACHE_VALID_DAYS=365

# What: CacheHamster prefill; all empty = does nothing.
# Why: credential and URL list stay an operator choice.
# From: Issue #871
CACHEHAMSTER_CREDENTIAL_PERSISTENCE=
CACHEHAMSTER_STEAM_CREDENTIAL=
CACHEHAMSTER_URLS=
CACHEHAMSTER_CONCURRENCY=4
