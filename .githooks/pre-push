#!/usr/bin/env bash
# LanCache-NG (https://github.com/wiki-mod/lancache-ng)
# SPDX-License-Identifier: AGPL-3.0-or-later

# What: runs the Node-version check if workflows changed
# Why: optional early warning; CI runs the same script
# From: Issue #801
set -uo pipefail

remote_name="${1:-origin}"

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "pre-push (check-action-node-versions): could not determine repo root; skipping this local check (not blocking push)." >&2
  exit 0
}

script="$repo_root/scripts/tracked/check-action-node-versions.sh"
if [ ! -f "$script" ]; then
  echo "pre-push (check-action-node-versions): $script not found; skipping this local check (not blocking push)." >&2
  exit 0
fi

if ! command -v curl >/dev/null 2>&1; then
  echo "pre-push (check-action-node-versions): curl not found on PATH; skipping this local check (CI still enforces it)." >&2
  exit 0
fi

is_zero_sha() {
  [ "$1" = "0000000000000000000000000000000000000000" ]
}

# What: sets workflow_changed if a workflow file changed
# Why: the check needs network; most pushes skip it
workflow_changed=0
# What: reads the 4 pre-push stdin fields per ref
# Why: local_ref is unused; naming it keeps the slots

# shellcheck disable=SC2034
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  # What: skips deleted refs (all-zero local sha)
  # Why: a deleted ref has no commits to scan
  is_zero_sha "$local_sha" && continue

  if is_zero_sha "${remote_sha:-}"; then
    # What: base is merge-base with remote branch or root
    # Why: a new remote ref has no remote sha to diff
    base=$(git merge-base HEAD "${remote_name}/${remote_ref#refs/heads/}" 2>/dev/null) || base=""
    if [ -z "$base" ]; then
      base=$(git rev-list --max-parents=0 "$local_sha" 2>/dev/null | tail -n1) || base=""
    fi
  else
    base="$remote_sha"
  fi

  if [ -n "$base" ]; then
    # What: diff output goes to a variable, not a pipe
    # Why: [AG-VAL-032] grep -q can mask SIGPIPE status
    changed_workflow_files=$(git diff --name-only "$base" "$local_sha" -- '.github/workflows/*.yml' '.github/workflows/*.yaml' 2>/dev/null) || changed_workflow_files=""
    if [ -n "$changed_workflow_files" ]; then
      workflow_changed=1
    fi
  else
    workflow_changed=1
  fi
done

if [ "$workflow_changed" -eq 0 ]; then
  exit 0
fi

echo "pre-push: .github/workflows changed -- running scripts/tracked/check-action-node-versions.sh (#801) as an early local warning (CI enforces this authoritatively either way)..." >&2

if ! bash "$script" "$repo_root"; then
  echo "pre-push: check-action-node-versions.sh found a problem (see above) -- push blocked." >&2
  echo "This is an optional local check; if you believe this is a false positive or an infrastructure hiccup (rate limit, network), you can bypass it with 'git push --no-verify' -- CI runs the same check authoritatively regardless." >&2
  exit 1
fi

exit 0
