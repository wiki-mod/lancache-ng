#!/usr/bin/env bash
# LanCache-NG (https://github.com/wiki-mod/lancache-ng)
# SPDX-License-Identifier: AGPL-3.0-or-later

# What: runs the node-version check on workflow changes
# Why: optional early warning; CI runs the same check
# From: Issue #801 | PR #1912
set -uo pipefail

remote_name="${1:-origin}"
remote_url="${2:-}"

repo_root=$(git rev-parse --show-toplevel 2>&1) || {
  echo "pre-push (action-node-versions): could not determine repo root ($repo_root); skipping this local check (not blocking push)." >&2
  exit 0
}

script="$repo_root/.github/scripts/ci.sh"
if [ ! -f "$script" ]; then
  echo "pre-push (action-node-versions): $script not found; skipping this local check (not blocking push)." >&2
  exit 0
fi

for tool in curl yq jq; do
  if [ -z "$(command -v "$tool")" ]; then
    echo "pre-push (action-node-versions): $tool not found on PATH; skipping this local check (CI still enforces it)." >&2
    exit 0
  fi
done

# What: derives owner/repo from the push remote URL
# Why: ci.sh reads GITHUB_REPOSITORY; a local run has none
if [ -z "${GITHUB_REPOSITORY:-}" ]; then
  if [ -z "$remote_url" ]; then
    remote_url=$(git remote get-url "$remote_name" 2>&1) || {
      echo "pre-push (action-node-versions): no URL for remote '$remote_name' ($remote_url); skipping this local check (not blocking push)." >&2
      exit 0
    }
  fi
  github_repo="${remote_url%.git}"
  case "$github_repo" in
    *github.com[:/]*/*) GITHUB_REPOSITORY="${github_repo#*github.com[:/]}" ;;
    *)
      echo "pre-push (action-node-versions): remote '$remote_name' is not a github.com URL; skipping this local check (not blocking push)." >&2
      exit 0
      ;;
  esac
  export GITHUB_REPOSITORY
fi

# What: tells whether a sha is the all-zero null sha
# Why: git sends 40 zeros for a deleted or a new ref
is_zero_sha() {
  [ "$1" = "0000000000000000000000000000000000000000" ]
}

# What: sets workflow_changed if a workflow file changed
# Why: the check needs network; most pushes skip it
workflow_changed=0
# What: reads the 4 pre-push stdin fields per ref
# Why: "_" holds the unused local ref; the slots stay right
while read -r _ local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  # What: skips deleted refs (all-zero local sha)
  # Why: a deleted ref has no commits to scan
  is_zero_sha "$local_sha" && continue

  if is_zero_sha "${remote_sha:-}"; then
    # What: base is merge-base with remote branch or root
    # Why: a new remote ref has no remote sha to diff
    if ! base=$(git merge-base HEAD "${remote_name}/${remote_ref#refs/heads/}" 2>&1); then
      echo "pre-push: no merge-base with the remote branch ($base); using the root commit." >&2
      roots=$(git rev-list --max-parents=0 "$local_sha" 2>&1) || {
        echo "pre-push: git rev-list failed ($roots); running the check." >&2
        roots=""
      }
      base=$(printf '%s\n' "$roots" | tail -n1)
    fi
  else
    base="$remote_sha"
  fi

  if [ -n "$base" ]; then
    # What: diff output goes to a variable, not a pipe
    # Why: [AG-VAL-032] grep -q can mask SIGPIPE status
    if ! changed_workflow_files=$(git diff --name-only "$base" "$local_sha" -- '.github/workflows/*.yml' '.github/workflows/*.yaml' 2>&1); then
      echo "pre-push: git diff failed ($changed_workflow_files); running the check." >&2
      workflow_changed=1
    elif [ -n "$changed_workflow_files" ]; then
      workflow_changed=1
    fi
  else
    workflow_changed=1
  fi
done

if [ "$workflow_changed" -eq 0 ]; then
  exit 0
fi

echo "pre-push: .github/workflows changed -- running ci.sh check action-node-versions (#801) as an early local warning (CI enforces this authoritatively either way)..." >&2

if ! bash "$script" check action-node-versions; then
  echo "pre-push: check action-node-versions found a problem (see above) -- push blocked." >&2
  echo "This is an optional local check; if you believe this is a false positive or an infrastructure hiccup (rate limit, network), you can bypass it with 'git push --no-verify' -- CI runs the same check authoritatively regardless." >&2
  exit 1
fi

exit 0
