+          [[ "$STACK_DIGEST" =~ ^sha256:[0-9a-fA-F]{64}$ ]] || { echo "::error::Missing or malformed stack pointer digest '$STACK_DIGEST'."; exit 1; }
           stack_tag_image="ghcr.io/${REPOSITORY}/stack:${source_tag}"
