-            for service in "${services[@]}"; do
-              env_key="$(printf '%s' "$service" | tr '[:lower:]-' '[:upper:]_')"
-              printf 'LANCACHE_IMAGE_DIGEST_%s=%s\n' "$env_key" "${merged_digests[$service]}"
-            done
           } > "$pointer_context/stack.env"
 
