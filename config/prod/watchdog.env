
# LanCache-NG (https://github.com/wiki-mod/lancache-ng)
# SPDX-License-Identifier: AGPL-3.0-or-later
# Watchdog service configuration for container monitoring and health checks (prod deployment).

# HTTP URL for the Docker socket proxy (haproxy with limited ACLs)
DOCKER_PROXY_URL=http://docker-socket-proxy:2375

# Whether to monitor and manage SSL-mode DNS service (dns-ssl container)
SSL_ENABLED=1

# Health check polling interval in seconds
CHECK_INTERVAL=30

# Number of consecutive health failures before restarting a container
RESTART_AFTER=3

# Disk usage warning threshold as percentage (yellow alert)
DISK_WARN_PCT=85

# Disk usage alarm threshold as percentage (red alert, critical)
DISK_ALARM_PCT=95

# Cache entries older than this many days are eligible for purge during daily cleanup
CACHE_VALID_DAYS=365

# Path to the shared cache directory (mounted from the host)
CACHE_DIR=/var/cache/lancache

# Docker container name for the unified proxy (handles both standard and SSL modes)
CONTAINER_PROXY=lancache-proxy

# Docker container name for the standard-mode DNS service
CONTAINER_DNS_STANDARD=lancache-dns-standard

# Docker container name for the SSL-mode DNS service
CONTAINER_DNS_SSL=lancache-dns-ssl

# Docker container name for the NATS message bus; this service is always monitored.
CONTAINER_NATS=lancache-nats

# Size cap (MB) for /data/fluent-bit.log on the syslog-data volume before the
# retention process rotates it, plus the number of compressed backups to keep.
# This path has no separate enable toggle because uncontrolled self-log growth
# can consume the same bounded storage even when syslog retention is disabled.
FLUENT_BIT_SELFLOG_MAX_MB=20
FLUENT_BIT_SELFLOG_MAX_ROTATIONS=5

# DHCP_MODE, SYSLOG_ENABLED, and LOGGING_ENABLED are deliberately not static
# defaults here. All three describe per-install deployment state and must match
# the top-level .env instead of a repository-wide value. deploy/prod/docker-
# compose.yml therefore passes them directly into the watchdog container.
# DHCP_MODE is consumed by the prepared Rust alert-only target resolver.
# SYSLOG_ENABLED remains the narrower retention/pruning opt-in and does not
# determine whether central logging exists. LOGGING_ENABLED is read by the live
# Bash watchdog and gates whether the combined syslog/fluent-bit container is
# included in alert-only health monitoring.
