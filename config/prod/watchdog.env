# SPDX-License-Identifier: AGPL-3.0-or-later
# lancache-ng (https://github.com/wiki-mod/lancache-ng)
# Watchdog service configuration for container monitoring and health checks (prod deployment).

# HTTP URL for the Docker socket proxy (haproxy with limited ACLs)
DOCKER_PROXY_URL=http://docker-socket-proxy:2375

# Whether to monitor and manage SSL-mode DNS service (dns-ssl container)
SSL_ENABLED=1

# Health check polling interval in seconds
CHECK_INTERVAL=30

# Number of consecutive health failures before restarting a container
RESTART_AFTER=3

# Disk usage warning threshold as percentage (yellow alert)
DISK_WARN_PCT=85

# Disk usage alarm threshold as percentage (red alert, critical)
DISK_ALARM_PCT=95

# Cache entries older than this many days are eligible for purge during daily cleanup
CACHE_VALID_DAYS=365

# Path to the shared cache directory (mounted from the host)
CACHE_DIR=/var/cache/lancache

# Docker container name for the unified proxy (handles both standard and SSL modes)
CONTAINER_PROXY=lancache-proxy

# Docker container name for the standard-mode DNS service
CONTAINER_DNS_STANDARD=lancache-dns-standard

# Docker container name for the SSL-mode DNS service
CONTAINER_DNS_SSL=lancache-dns-ssl

# Docker container name for the NATS message bus (always monitored -- see #842)
CONTAINER_NATS=lancache-nats

# Fluent-bit self-log rotation (#1236). Size cap (MB) for /data/fluent-bit.log
# on the syslog-data volume before watchdog rotates it; number of compressed
# rotated backups to retain before the oldest is deleted. Unlike
# SYSLOG_ENABLED/SYSLOG_MAX_GB/SYSLOG_RETENTION_DAYS above, this has no
# separate enable toggle -- see maybe_rotate_fluent_bit_selflog()'s comment
# in services/watchdog/watchdog.sh for why.
FLUENT_BIT_SELFLOG_MAX_MB=20
FLUENT_BIT_SELFLOG_MAX_ROTATIONS=5

# DHCP_MODE, SYSLOG_ENABLED, and LOGGING_ENABLED are deliberately NOT set as
# static defaults in this file: unlike every setting
# above, all three vary per install and must track the top-level .env's
# real, per-deployment value (whichever DHCP mode is actually provisioned;
# whether syslog retention/pruning was separately opted into; whether
# central logging is actually enabled) -- a hardcoded default here would
# silently disagree with reality the moment an operator's real .env
# differs. deploy/prod/docker-compose.yml's `watchdog` service instead
# passes all three directly from the top-level .env via its own
# `environment:` block, the same pattern the `retention` service already
# uses for SYSLOG_ENABLED. DHCP_MODE and SYSLOG_ENABLED are currently
# unused by watchdog.sh (the bash entrypoint this service still runs);
# DHCP_MODE is read only by the Rust rewrite's alert-only monitored-service
# resolution (see services/watchdog/src/config.rs's dhcp_alert_container()
# and services/watchdog/src/lib.rs's module doc comment for the still-open
# ENTRYPOINT question), and SYSLOG_ENABLED there gates only the
# storage-budget retention/pruning engine, not this service's own health
# monitoring. LOGGING_ENABLED IS genuinely read by watchdog.sh today: it
# gates whether the syslog+fluent-bit container is considered part of this
# stack for alert-only health monitoring (see watchdog.sh's own C_SYSLOG
# assignment) -- deliberately not SYSLOG_ENABLED, since a normal install
# with central logging on but retention/pruning never separately opted into
# would otherwise go unmonitored by default.
