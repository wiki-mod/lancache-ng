
# LanCache-NG (https://github.com/wiki-mod/lancache-ng)
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# What: query logging off; local root zone copy on.
# Why: query logs grow fast; the root copy saves lookups.
LOG_QUERIES=0
ROOT_ZONE_MIRROR=1

# What: SOA refresh/retry for secondary re-poll
# Why: Mitigates resync delay from missed NOTIFY
# From: Issue #1095
PDNS_SOA_REFRESH=30
PDNS_SOA_RETRY=10
# What: Re-anchor serial at day rollover
# Why: Ensures secondary sync when zone unchanged
# From: Issue #1095
PDNS_SOA_RESYNC_INTERVAL=3600
