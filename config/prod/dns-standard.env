
# LanCache-NG (https://github.com/wiki-mod/lancache-ng)
# SPDX-License-Identifier: AGPL-3.0-or-later
# What: IPv4 for standard-mode proxy (no SSL)
# Why: Distinguishes standard vs. SSL mode
PROXY_IP=192.168.234.10
# PROXY_IPV6=
LOG_QUERIES=0
PDNS_API_KEY=CHANGE_ME_PDNS_API_KEY
# What: DDNS_ALLOW_FROM set in docker-compose, not here
# Why: .env values are not variable-interpolated at runtime
DDNS_ALLOW_FROM=
ROOT_ZONE_MIRROR=1
NATS_CONSUMER=dns-standard
NATS_RECONCILER=1

# What: Retain N configs for rollback on failure
# Why: Auto-recovery from invalid configs
# From: Issue #415 | PR #615
KEEP_KNOWN_GOOD_CONFIGS=3

# What: SOA refresh/retry for secondary re-poll
# Why: Mitigates resync delay from missed NOTIFY
# From: Issue #1095
PDNS_SOA_REFRESH=30
PDNS_SOA_RETRY=10
# What: Re-anchor serial at day rollover
# Why: Ensures secondary sync when zone unchanged
# From: Issue #1095
PDNS_SOA_RESYNC_INTERVAL=3600
