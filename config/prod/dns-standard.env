
# LanCache-NG (https://github.com/wiki-mod/lancache-ng)
# SPDX-License-Identifier: AGPL-3.0-or-later
# What: IPv4 for standard-mode DNS proxy (no SSL interception)
# Why: Separates standard-mode from SSL-enabled configuration
PROXY_IP=192.168.234.10
# PROXY_IPV6=
LOG_QUERIES=0
PDNS_API_KEY=CHANGE_ME_PDNS_API_KEY
# What: DDNS_ALLOW_FROM set in docker-compose, not here
# Why: .env values are not variable-interpolated at runtime
DDNS_ALLOW_FROM=
ROOT_ZONE_MIRROR=1
NATS_CONSUMER=dns-standard
NATS_RECONCILER=1

# What: Retain N validated configs for rollback on startup failure
# Why: Enables automatic recovery from invalid config changes
# From: Issue #415 | PR #615
KEEP_KNOWN_GOOD_CONFIGS=3

# What: SOA refresh/retry for secondary re-polling on NOTIFY loss
# Why: Mitigates resync delays when secondary misses NOTIFY
# From: Issue #1095
PDNS_SOA_REFRESH=30
PDNS_SOA_RETRY=10
# What: Force-resync cadence: re-anchor serial at day rollover
# Why: Ensures secondaries sync even when zone unchanged
# From: Issue #1095
PDNS_SOA_RESYNC_INTERVAL=3600
