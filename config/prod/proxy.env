
# LanCache-NG (https://github.com/wiki-mod/lancache-ng)
# SPDX-License-Identifier: AGPL-3.0-or-later
# nginx HTTP/HTTPS proxy cache settings and security configuration (prod deployment).
# Prod: adjust CACHE_MAX_SIZE to your available disk space
CACHE_MAX_SIZE=50g
CACHE_MEM_MB=512
CACHE_SLICE_SIZE=8m
CACHE_VALID_HIT=365d
CACHE_VALID_ANY=1m
CACHE_INACTIVE=365d
# Defense-in-depth disk-space floor (bug-hunt #849 item 11): nginx's cache
# manager evicts LRU cache entries once free space at CACHE_DIR's filesystem
# drops below this, independent of and in addition to CACHE_MAX_SIZE above.
# CACHE_MAX_SIZE alone is not a hard limit (see docs/architecture-ng.md's
# "Cache Retention & Cleanup" section) and the cache volume can share a
# filesystem with other data (OS, logs, other containers) on a single-disk
# host -- this value only needs raising if your host's real free-space
# headroom below CACHE_MAX_SIZE is itself smaller than 1g.
CACHE_MIN_FREE=1g

# Real upstream DNS for nginx origin lookups. Do not set this to a LanCache DNS/proxy IP.
# Includes both IPv4 and IPv6 Google Public DNS addresses to match this project's
# dual-stack support (see AGENTS.md's project description and AG-IPV6-001 --
# corrected 2026-08-05, issue #1391 doc-sweep audit: this used to cite CLAUDE.md,
# which no longer carries this content as of 2026-07-31); an IPv6-only/IPv6-preferring
# deployment still gets a working resolver even if IPv4 upstream reachability is limited.
# IPv6 literals are bracketed ([addr]) because nginx's `resolver` directive
# requires brackets around IPv6 nameservers, with or without an explicit port.
# On an IPv4-only host/network (no IPv6 route at all), the two bracketed
# entries below are simply unreachable and add no more than resolver_timeout
# (5s, see services/proxy/nginx.conf) of latency on the rare query that picks
# one before nginx retries the next server; if that's undesirable, remove them.
NGINX_UPSTREAM_RESOLVER=8.8.8.8 8.8.4.4 [2001:4860:4860::8888] [2001:4860:4860::8844]

# Proxy security mode:
# - lazy (default): preserve LanCache-style behavior; proxy any host that reaches the cache.
#   This is a deliberate cache-first choice so new CDN hostnames keep working out of the box.
# - strict: only proxy hosts derived from services/dns/cdn-domains.txt.
PROXY_SECURITY_MODE=lazy

# Optional source-IP allowlist for clients that may use the proxy.
# Leave empty to allow all clients that can reach the bound LAN/Docker ports.
# Example: PROXY_ALLOWED_CLIENT_CIDRS=192.168.1.0/24 172.16.0.0/12
PROXY_ALLOWED_CLIENT_CIDRS=

# Known-good configuration snapshot retention (#415). How many
# validated configs to keep for automatic rollback if a newly generated
# config fails validation at startup. See docs/known-good-config-snapshots.md.
KEEP_KNOWN_GOOD_CONFIGS=3
