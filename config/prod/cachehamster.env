
# LanCache-NG (https://github.com/wiki-mod/lancache-ng)
# SPDX-License-Identifier: AGPL-3.0-or-later
# CacheHamster (Steam cache-warming prefill scaffold, issue #871)
# configuration - Production. Opt-in via the `cachehamster` Compose
# profile (default off); see docs/design-steam-prefill.md for the current
# implementation status (credential-store + stream-fetch primitives only,
# no real Steam depot-fetch capability yet).

# Whether the Steam credential below is encrypted at rest under CACHEHAMSTER_DATA_DIR
# ("persistent") or held only in memory for this run ("none"). Left unset
# (defaults to "none") until an operator makes this choice deliberately --
# see docs/design-steam-prefill.md's "Credential strategy" decision.
CACHEHAMSTER_CREDENTIAL_PERSISTENCE=

# Operator-supplied Steam credential. Left empty by default: with no
# credential and no CACHEHAMSTER_URLS configured, the scaffold logs a warning
# and exits without doing anything (safe to enable this profile with no
# other configuration).
CACHEHAMSTER_STEAM_CREDENTIAL=

# Comma-separated URL list this scaffold streams-and-discards through the
# proxy. Stand-in for real depot-manifest resolution, which does not exist
# yet (see docs/design-steam-prefill.md). Left empty by default.
CACHEHAMSTER_URLS=

# Number of in-flight fetches. Defaults to 4 in the binary itself when
# unset or invalid; left unset here so that default applies.
CACHEHAMSTER_CONCURRENCY=
