
# LanCache-NG (https://github.com/wiki-mod/lancache-ng)
# SPDX-License-Identifier: AGPL-3.0-or-later
# Kea DHCP server and dynamic DNS configuration (prod deployment).
# DHCP Server Configuration (Kea) - Production

DHCP_DOMAIN=lan
DHCP_LEASE_TIME=86400
# Public NTP default is Debian pool plus NIST; set empty only to disable DHCP NTP.
DHCP_NTP_SERVERS=debian.pool.ntp.org,time.nist.gov

# Kea Control Agent authentication is shared with the Admin UI.
# Set KEA_CTRL_TOKEN in deploy/prod/.env, not here, so Compose gives both
# services the same value.

# What: Kea Control Agent API bind address
# Why: entrypoint fences it to loopback and Docker nets
# From: Issue #1683 | PR #1858
KEA_CTRL_HOST=0.0.0.0

# Enable DDNS updates (issue #1076): when true, Kea writes an A + PTR record
# for each lease via the D2 daemon (dhcp-ddns.enable-updates). Independent of
# DHCP_MODE -- running Kea DHCP does not by itself mean DNS should be updated.
# Off by default (opt-in), matching Kea's own default. Only affects a FRESH
# install's first-boot render; an already-running install keeps whatever the
# Admin UI's "Enable DDNS Updates" toggle last wrote (see entrypoint.sh's
# migrate_dhcp4_config). Accepts true/false (also 1/0/yes/no/on/off).
DHCP_DDNS_ENABLED=false
