# lancache-ng (https://github.com/wiki-mod/lancache-ng)
# systemd timer that triggers lancache-ci-cleanup.service daily; see README.md.
[Unit]
Description=Daily lancache-ng CI runner host docker cleanup

[Timer]
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=900
Persistent=true

[Install]
WantedBy=timers.target
