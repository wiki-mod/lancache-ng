
# LanCache-NG (https://github.com/wiki-mod/lancache-ng)
# SPDX-License-Identifier: AGPL-3.0-or-later
# Git ignore patterns for build artifacts, secrets, and generated files

# What: state dirs an install keeps in the checkout
# Why: runtime state and leases do not belong in git
data/
/cache/
/kea/
/nats/
/nats-conf/
/pdns/
/pdns-filter-state/
/ntp/
/syslog-ng/
/cachehamster/

# What: install env files that hold credentials
# Why: AG-SEC-003: credentials are never committed
/.env
deploy/prod/.env.local
config/prod/*.local.env

# What: local Claude Code settings
# Why: per-user tool state, not project content
.claude/

# What: metadata files of the OS file browser
# Why: macOS and Windows write them, not the project
.DS_Store
Thumbs.db

# What: ignores the one workspace build dir /target/.
# Why: the Cargo workspace builds into one target dir.
# From: Issue #1095
/target/

# What: editor swap files and IDE settings
# Why: per-user editor state, not project content
*.swp
*.swo
.idea/
.vscode/

# What: the workspace lock ci.sh generates per job.
# Why: no third-party pin; cargo resolves the latest.
# From: Issue #1683 | PR #1858
/Cargo.lock
